# Forza i MIME type corretti per i file statici.
# Importante: serve i .js come JavaScript (evita l'errore
# "Expected a JavaScript-or-Wasm module script ... text/plain").
AddType text/javascript .js .mjs
AddType text/css .css
AddType application/json .json
AddType image/svg+xml .svg
AddType image/webp .webp
AddType video/mp4 .mp4

<IfModule mime_module>
    AddType text/javascript .js .mjs
</IfModule>

# CORS per font e risorse statiche
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|css|woff|woff2|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|mp4|webm)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# Sito multi-pagina: ogni pagina è un vero file .html, nessun rewrite necessario.
